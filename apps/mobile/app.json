{
  "expo": {
    "name": "Tribali Liga",
    "slug": "tribali-liga",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tribaliliga.app"
    },
    "android": {
      "package": "com.tribaliliga.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C9A227"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tribali Liga koristi galeriju da otpremis slike i video zapise (npr. gol nedelje, vesti, profilnu sliku).",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "965fb240-c1b0-4961-91a4-b92b2960e1c0"
      }
    },
    "owner": "tribalis-team"
  }
}
