# iOS simulator / Expo web: 127.0.0.1 works as-is.
# Android emulator: use http://10.0.2.2:8787 instead.
# Physical phone with Expo Go: use your computer's LAN IP, e.g. http://192.168.1.23:8787
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8787
# Publishable (anon) key, safe to expose client-side - used only to upload media
# directly to the public app-media storage bucket via a short-lived signed URL.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
