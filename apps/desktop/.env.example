# PostHog analytics - Project Settings > Project token/ID in the PostHog dashboard.
# Same project as apps/mobile/.env, so desktop web and the mobile app show up together.
# Left empty, analytics silently no-ops instead of breaking anything.
EXPO_PUBLIC_POSTHOG_API_KEY=
# https://us.i.posthog.com if you picked the US region at signup, https://eu.i.posthog.com for EU
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# On Render this is set as a build-time Environment Variable on the desktop static
# site, since EXPO_PUBLIC_* vars get baked into the exported JS bundle at build time.
