# Copy this file to .env and fill in real values (ask the project owner for them).

# Postgres connection string (Supabase pooler URL)
DATABASE_URL=

# Supabase project
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Admin login used by apps/admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary - used for all photo/video uploads (player photos, team logos, news,
# stories, sponsors). Get these from the Cloudinary dashboard under Settings > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 0.0.0.0 so the API accepts LAN connections (needed for testing on a physical phone)
API_HOST=0.0.0.0

# Used by the mobile app to reach the API - set to this machine's LAN IP for a physical
# phone via Expo Go, or 127.0.0.1 for web/iOS simulator
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8787

# PostHog analytics (apps/mobile and apps/desktop both read this - one project covers
# both). Free account at https://posthog.com - Project Settings > Project API Key.
# Left empty, analytics silently no-ops instead of breaking anything.
EXPO_PUBLIC_POSTHOG_API_KEY=
# https://us.i.posthog.com if you picked the US region at signup, https://eu.i.posthog.com for EU
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
