# Copy this file to .env and fill in real values (ask the project owner for them).

# Postgres connection string (Supabase pooler URL)
DATABASE_URL=

# Supabase project
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Admin login used by apps/admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary - used for all photo/video uploads (player photos, team logos, news,
# stories, sponsors). Get these from the Cloudinary dashboard under Settings > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 0.0.0.0 so the API accepts LAN connections (needed for testing on a physical phone)
API_HOST=0.0.0.0

# Used by the mobile app to reach the API - set to this machine's LAN IP for a physical
# phone via Expo Go, or 127.0.0.1 for web/iOS simulator
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8787

# Client-side PostHog analytics - free account at https://posthog.com, Project Settings
# > Project API Key. NOT read from here: Expo reads env vars from each app's own .env,
# so the real values go in apps/mobile/.env.example and apps/desktop/.env.example
# instead - same project/key in both, so one PostHog project covers both apps.

# Server-side PostHog (apps/api reads this one from here) - used to read analytics data
# back out for the admin Statistika screen. Personal API Key: avatar/profile icon
# (bottom-left of the PostHog sidebar) > Account settings > Personal API Keys > Create.
# Project ID and API host (eu.posthog.com or us.posthog.com, matching your account's
# region) are both on the same Project Settings page as the client-side key above.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com
